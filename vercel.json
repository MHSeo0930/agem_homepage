{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "icn1"
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/agem_homepage/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/agem_homepage/api/uploads/:file",
      "destination": "/agem_homepage/uploads/:file"
    }
  ]
}
